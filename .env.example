# ===== Turso 数据库（生产用；本地开发可留空） =====
# Turso 数据库连接 URL，格式 libsql://xxx.turso.io
# 留空则使用本地文件模式 file:.data/local.db（无需任何配置即可本地开发）
NUXT_TURSO_DATABASE_URL=

# Turso 数据库访问令牌（turso db tokens create <库名> 获取）
# 仅当上面的 URL 配置了远程 Turso 库时才需要填写
NUXT_TURSO_AUTH_TOKEN=

# ===== GitHub OAuth 登录 =====
# GitHub OAuth App 的 Client ID
# 在 https://github.com/settings/developers 新建 OAuth App 后获得
NUXT_OAUTH_GITHUB_CLIENT_ID=

# GitHub OAuth App 的 Client Secret（同上页面生成）
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# ===== 会话加密 =====
# 会话 cookie 加密密码，必须 ≥32 位随机字符串
# 本地开发缺失时 nuxt-auth-utils 会自动生成并写入 .env；
# 生产环境必须显式设置，否则 session 解密失败报 500（会掩盖鉴权 401，极难排查）
# 生成示例：openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# ===== 登录白名单 =====
# 允许登录的 GitHub 用户名（白名单，只填你自己的用户名，不带 @）
# 留空或不匹配时 GitHub 登录一律 403 拒绝，仅本地 dev 旁路（/auth/dev）可用
NUXT_GITHUB_ALLOWED_USER=
